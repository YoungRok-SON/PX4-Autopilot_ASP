#!/bin/sh
#
# @name ANCHOR 2027 cage quad (SITL, no GNSS)
#
# @type Quadrotor x
# @class Copter
#
# Generated by competition/anchor2027/tools/gen_px4_airframe.py from px4/params_anchor.params (common, real + sim)
# and px4/params_anchor_sim.params (simulation only). Edit those files, not this one.  ACDL Son Yeongrok

. ${R}etc/init.d/rc.mc_defaults

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104

# ===== common (params_anchor.params) =====
# ANCHOR 2027 cage quad - COMMON parameters (real aircraft + simulator). One `param set-default` per line, reason after '#'.
# Simulation-only values live in params_anchor_sim.params. Both are merged into the airframe 22000_none_anchor_cage_quad
# by tools/gen_px4_airframe.py. TODO(real) = estimate until the prototype is measured.   ACDL Son Yeongrok

# --- geometry (config/fdm_anchor_cage_quad.yaml: arm 0.078 m, X layout, PX4 motor order FR, RL, FL, RR) ---
param set-default CA_AIRFRAME 0                  # multirotor
param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR0_PX 0.078             # FR  (x fwd) TODO(real) motor spacing
param set-default CA_ROTOR0_PY 0.078             #     (y right)
param set-default CA_ROTOR0_CT 10               # thrust coef. Only ratios between axes matter, BUT PX4 control_allocator zeroes any axis row whose |CT*KM| <= 0.05 (weak-authority gate). Default CT 6.5 x KM 0.0076 = 0.049 -> yaw row zeroed -> no yaw control. CT 10 x 0.0076 = 0.076 keeps yaw. (evidence/yaw_fix)
param set-default CA_ROTOR0_KM 0.0076            # CCW, Q/T = 0.00755 m (fdm yaml) TODO(real)
param set-default CA_ROTOR1_PX -0.078            # RL
param set-default CA_ROTOR1_PY -0.078
param set-default CA_ROTOR1_CT 10
param set-default CA_ROTOR1_KM 0.0076            # CCW
param set-default CA_ROTOR2_PX 0.078             # FL
param set-default CA_ROTOR2_PY -0.078
param set-default CA_ROTOR2_CT 10
param set-default CA_ROTOR2_KM -0.0076           # CW
param set-default CA_ROTOR3_PX -0.078            # RR
param set-default CA_ROTOR3_PY 0.078
param set-default CA_ROTOR3_CT 10
param set-default CA_ROTOR3_KM -0.0076           # CW

# --- rate/attitude gains: iris defaults x ~0.53 ---
# PX4 rate gains act on normalised torque, so the loop gain scales with torque authority / inertia.
# Authority here: 2 x Tmax(7.9 N) x arm 0.078 = 1.23 N*m over Ixx 0.0061 = 202 1/s^2 (design) vs the stock iris
# (about 2 x 6.5 N x 0.2 m = 2.6 N*m over 0.029 = 90 1/s^2): ratio 2.2 -> gains x 0.45..0.55. Flown and verified stable (evidence/t4_*).
param set-default MC_ROLLRATE_P 0.08
param set-default MC_ROLLRATE_I 0.10
param set-default MC_ROLLRATE_D 0.0018
param set-default MC_PITCHRATE_P 0.08
param set-default MC_PITCHRATE_I 0.10
param set-default MC_PITCHRATE_D 0.0018
param set-default MC_YAWRATE_P 0.12              # yaw authority is small (Q/T 0.0076) so keep P higher relative to roll
param set-default MC_YAWRATE_I 0.10
param set-default MPC_THR_HOVER 0.45             # 1.45 kg x 9.81 / (4 x 7.9 N) = 0.45 (fdm yaml) TODO(real) thrust curve
param set-default MPC_TILTMAX_AIR 25             # indoor cage, 5 m net: limit tilt
param set-default MPC_XY_VEL_MAX 1.5             # indoor 20 x 20 m arena
param set-default MPC_ACC_HOR 1.5
param set-default MPC_ACC_HOR_MAX 1.5
param set-default MPC_Z_VEL_MAX_UP 1.0
param set-default MPC_Z_VEL_MAX_DN 1.0

# --- estimator: NO GNSS, external vision (marker localisation) + barometer. Real aircraft has NO downward range sensor and NO optical flow; it uses a barometer. ---
param set-default EKF2_GPS_CTRL 0                # GNSS fusion off (indoor)
param set-default EKF2_EV_CTRL 11                # bit0 horizontal pos + bit1 vertical pos + bit3 yaw (marker pose, heading from markers)
param set-default EKF2_HGT_REF 3                 # height reference = vision
param set-default EKF2_OF_CTRL 0                 # optical flow OFF: the real aircraft has no optical flow sensor
param set-default EKF2_RNG_CTRL 0                # range finder OFF: the real aircraft has no downward distance sensor
param set-default EKF2_BARO_CTRL 1               # barometer fusion ON: the real aircraft uses its barometer (height reference stays vision, HGT_REF 3; baro bias is estimated against it)
param set-default EKF2_MAG_TYPE 5                # magnetometer off (electromagnet interference)
param set-default SYS_HAS_MAG 0                  # no magnetometer in the system
param set-default EKF2_EVP_NOISE 0.03            # marker position noise 3 cm (T6 target <= 5 cm)
param set-default EKF2_EVA_NOISE 0.05            # heading noise rad

# --- arming / failsafe (no RC, no GNSS) ---
param set-default COM_ARM_WO_GPS 1               # arm without GNSS
param set-default COM_RC_IN_MODE 4               # no RC; offboard/MAVLink only
param set-default COM_OF_LOSS_T 1.0              # offboard command loss timeout [s]
param set-default COM_OBL_RC_ACT 4               # offboard lost -> Land (enum: 4 = Land)
param set-default COM_POSCTL_NAVL 1              # position estimate lost -> Land/descend instead of manual/altitude
param set-default NAV_DLL_ACT 0                  # no GCS link loss action
param set-default NAV_RCL_ACT 0
param set-default GF_ACTION 5                    # geofence breach -> Land (enum 5)
param set-default GF_MAX_HOR_DIST 9.5            # set boundary - 0.5 m: half arena 10 m; home = start stand centre
param set-default GF_MAX_VER_DIST 2.2            # net ceiling 2.5 m (user decision 2026-11-17, was 5 m) - 0.3 m: protect the ceiling net
param set-default GF_SOURCE 0                    # estimator global position (needs a global origin, see injector)

# --- electromagnet on aux output (Peripheral via Actuator Set 1 -> MAV_CMD_DO_SET_ACTUATOR index 1) ---
param set-default PWM_MAIN_FUNC5 301             # output 5 = actuator set 1 (magnet: > 0 = ON)

# ===== simulation only (params_anchor_sim.params) =====
# ANCHOR 2027 cage quad - SIMULATION-ONLY parameters (not for the real flight controller). ACDL Son Yeongrok
# Merged with params_anchor.params by tools/gen_px4_airframe.py into 22000_none_anchor_cage_quad.

param set-default EKF2_EV_DELAY 200              # ms: measured sample->PX4 latency of the ROS marker node chain (median 195 ms, ULog T6); replaces the 40 ms of the old truth-based injector
param set-default MC_PITCHRATE_D 0.0            # SIM ONLY: D=0.0018 limit-cycles at 25 Hz with the 5 ms sim step (pitch rate sd 2.2 rad/s, motors +-0.35); real FC needs its own tuning
param set-default MC_ROLLRATE_D 0.0             # SIM ONLY: same reason
param set-default SIM_BAT_ENABLE 1               # PX4 battery simulator (PAS config has no battery sensor in the px4 variant)
param set-default COM_ARM_MAG_STR 0              # no magnetometer checks in sim
param set-default COM_ARM_EKF_AB 0.0             # accel bias check relaxed (simulated IMU, short warm-up)
param set-default COM_ARM_CHK_ESCS 0
param set-default CBRK_SUPPLY_CHK 894281         # no power module on SITL
param set-default SDLG_PROFILE 1                 # default logging profile  (name kept for ULog analysis)
param set-default SDLOG_PROFILE 1
param set-default SYS_AUTOCONFIG 0
param set-default EKF2_NOAID_TOUT 60000000       # us. SIM ONLY (2026-11-17, course v1 deliver mode): after landing on the pad the down camera cannot see floor markers (camera ~0.05-0.15 m above floor), so the EKF lost its position within the default 5 s and PX4 refused to re-arm ("Arming denied: Resolve system health failures first"). The vehicle is stationary on the ground, so dead reckoning for 60 s is harmless in sim; a real FC needs its own strategy (e.g. a marker under the pad).
