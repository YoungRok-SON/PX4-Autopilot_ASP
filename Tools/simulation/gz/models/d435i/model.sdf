<?xml version="1.0"?>
<sdf version="1.9">
  <model name="d435i">
    <static>false</static>

    <link name="d435i_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>0.072</mass>
        <inertia>
          <ixx>3.75e-06</ixx>
          <iyy>5.24e-05</iyy>
          <izz>5.24e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="body_visual">
        <pose>0.02 -0.03 0.0125 1.57079632679 0 1.57079632679</pose>
        <geometry>
          <mesh>
            <uri>model://d435i/meshes/d435.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="body_collision">
        <pose>0.02 -0.03 0.0125 1.57079632679 0 1.57079632679</pose>
        <geometry>
          <box>
            <size>0.090 0.025 0.02505</size>
          </box>
        </geometry>
      </collision>

      <sensor name="d435i_imu" type="imu">
        <pose>0 0 0 -1.57079632679 0 -1.57079632679</pose>
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>/d435i/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0005</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0005</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0005</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="d435i_rgb" type="camera">
        <pose>-0.0202141 0.00505961 0.0114047 0.002406 -0.002114 0.013799</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/d435i/rgb/image</topic>
        <camera>
          <horizontal_fov>1.211</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <intrinsics>
            <fx>617.201</fx>
            <fy>617.362</fy>
            <cx>324.637</cx>
            <cy>242.462</cy>
            <s>0</s>
          </intrinsics>
        </camera>
      </sensor>

      <sensor name="d435i_depth" type="depth_camera">
        <pose>-0.0202141 0.00505961 0.0114047 0.002406 -0.002114 0.013799</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/d435i/depth/image</topic>
        <camera>
          <!-- Align depth camera FOV to RGB camera for "registered-like" RGBD input -->
          <horizontal_fov>1.211</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <!-- Increase near plane to reduce self-occlusion (airframe/camera body visible in depth) -->
            <near>0.33</near>
            <far>10</far>
          </clip>
        </camera>
      </sensor>

      <!-- Left IR camera (mimics real D435i /infra1). Grayscale global-shutter-like
           pair for stereo-inertial VINS, closing the sim-to-real gap with the
           physical D435i. Baseline 50 mm along the link Y axis, centered on the
           RGB sensor. Intrinsics kept consistent with this SDF so the VINS stereo
           config is correct-by-construction. -->
      <sensor name="d435i_infra1" type="camera">
        <pose>-0.0202141 0.0300596 0.0114047 0.002406 -0.002114 0.013799</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/d435i/infra1/image</topic>
        <camera>
          <horizontal_fov>1.387</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <intrinsics>
            <fx>385.0</fx>
            <fy>385.0</fy>
            <cx>320.0</cx>
            <cy>240.0</cy>
            <s>0</s>
          </intrinsics>
        </camera>
      </sensor>

      <!-- Right IR camera (mimics real D435i /infra2), 50 mm to the right of infra1. -->
      <sensor name="d435i_infra2" type="camera">
        <pose>-0.0202141 -0.0199404 0.0114047 0.002406 -0.002114 0.013799</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/d435i/infra2/image</topic>
        <camera>
          <horizontal_fov>1.387</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <intrinsics>
            <fx>385.0</fx>
            <fy>385.0</fy>
            <cx>320.0</cx>
            <cy>240.0</cy>
            <s>0</s>
          </intrinsics>
        </camera>
      </sensor>

    </link>
  </model>
</sdf>
