<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_d435i">

    <!-- x500 본체 포함 -->
    <include merge="true">
      <uri>x500</uri>
    </include>

    <!-- d435i 모델 포함 (x500의 base_link 기준으로 장착 pose 정의) -->
    <include merge="true">
      <uri>model://d435i</uri>
      <pose relative_to="base_link">0.12 0.03 0.242 0 0 0</pose>
    </include>

    <!-- d435i의 "body frame"은 imu_link로 가정 (ORB-SLAM3 IMU.T_b_c1 구조 유지) -->
    <joint name="d435i_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

  </model>
</sdf>
